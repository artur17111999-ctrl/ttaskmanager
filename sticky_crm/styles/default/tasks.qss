/* Карточка задачи */
QFrame#taskCard {
    background-color: #1e2938;
    border: 1px solid #3a4658;
    border-radius: 16px;
    padding: 15px;
}

/* Наведение на карточку задачи */
QFrame#taskCard:hover {
    background-color: #263548;
    border: 1px solid #5b8cff;
}

/* Все элементы внутри карточки прозрачные */
QFrame#taskCard QLabel,
QFrame#taskCard QWidget {
    background-color: transparent;
}

/* Заголовок задачи */
QLabel#taskTitleLabel {
    background-color: transparent;
    color: white;
    font-size: 16px;
    font-weight: 700;
}

/* Описание задачи */
QLabel#taskDescriptionLabel {
    background-color: transparent;
    color: #c8d4e3;
    font-size: 14px;
}

/* Исполнитель */
QLabel#executorInfoLabel {
    background-color: transparent;
    color: #9fb0c5;
    font-size: 13px;
}

/* Дедлайн */
QLabel#deadlineInfoLabel {
    background-color: transparent;
    color: #9fb0c5;
    font-size: 13px;
}

/* Автор */
QLabel#authorInfoLabel {
    background-color: transparent;
    color: #71839a;
    font-size: 12px;
}

/* Кнопка удаления задачи (красная) */
QPushButton#deleteTaskButton {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #e74c3c,
        stop:1 #c0392b
    );
    color: white;
    border: none;
    border-radius: 14px;
    padding: 11px 18px;
    font-size: 14px;
    font-weight: 700;
}

/* Наведение на кнопку удаления */
QPushButton#deleteTaskButton:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #ff6b5b,
        stop:1 #e74c3c
    );
}

/* Нажатие на кнопку удаления */
QPushButton#deleteTaskButton:pressed {
    background: #a93226;
}

/* Бейдж низкого приоритета */
QLabel#priorityLow {
    background-color: #2ecc71;
    color: white;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}

/* Бейдж среднего приоритета */
QLabel#priorityMedium {
    background-color: #f39c12;
    color: white;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}

/* Бейдж критичного приоритета */
QLabel#priorityCritical {
    background-color: #e74c3c;
    color: white;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}

/* Бейдж приоритета-блокера */
QLabel#priorityBlocker {
    background-color: #9b59b6;
    color: white;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}

/* Группа комментариев */
QGroupBox#commentsGroup {
    background-color: #1e2938;
    border: 1px solid #3a4658;
    border-radius: 16px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: white;
}

QGroupBox#commentsGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    padding: 0 5px;
    color: #c8d4e3;
}

/* Группа добавления комментария */
QGroupBox#commentInputGroup {
    background-color: #1e2938;
    border: 1px solid #3a4658;
    border-radius: 16px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: white;
}

QGroupBox#commentInputGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    padding: 0 5px;
    color: #c8d4e3;
}

/* Поле ввода комментария */
QTextEdit#commentEdit {
    background-color: #18222d;
    border: 1px solid #3a4658;
    border-radius: 8px;
    color: white;
    padding: 8px;
    font-size: 14px;
    selection-background-color: #3390ec;
}

QTextEdit#commentEdit:focus {
    border: 1px solid #3390ec;
}

/* Кнопка отправки комментария */
QPushButton#sendCommentButton {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #3390ec,
        stop:1 #2578c9
    );
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 700;
    min-width: 100px;
}

QPushButton#sendCommentButton:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #4da3ff,
        stop:1 #3390ec
    );
}

QPushButton#sendCommentButton:pressed {
    background: #1e5f99;
}

/* Карточка комментария */
QFrame#commentFrame {
    background-color: #18222d;
    border-radius: 8px;
    border: 1px solid #3a4658;
}

/* Автор комментария */
QLabel#commentAuthorLabel {
    color: white;
    font-size: 13px;
    font-weight: bold;
    background-color: transparent;
}

/* Время комментария */
QLabel#commentTimeLabel {
    color: #8fa3b8;
    font-size: 11px;
    background-color: transparent;
}

/* Текст комментария */
QLabel#commentTextLabel {
    color: white;
    font-size: 14px;
    background-color: transparent;
}

QWidget#screenshotPreview {
    background-color: transparent;
}

QLabel#screenshotPreviewLabel, QLabel#attachmentSectionLabel {
    color: #9fb0c5;
    font-size: 12px;
    background-color: transparent;
}

QPushButton#clearScreenshotsButton {
    background-color: transparent;
    color: #65b8ff;
    border: none;
    padding: 3px 7px;
}

QPushButton#clearScreenshotsButton:hover {
    color: #ffffff;
    text-decoration: underline;
}

QLabel#screenshotAttachment {
    background-color: #18222d;
    border: 1px solid #3a4658;
    border-radius: 8px;
    padding: 4px;
}
