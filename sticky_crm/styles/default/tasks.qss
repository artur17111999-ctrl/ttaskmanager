/* ===============================
   TASK CARD
   =============================== */


/* Карточка задачи */
QFrame#taskCard {

    background-color: #1e2938;

    border: 1px solid #3a4658;

    border-radius: 16px;

    padding: 15px;

}


/* Наведение */
QFrame#taskCard:hover {

    background-color: #263548;

    border: 1px solid #5b8cff;

}


/* Все элементы внутри карточки прозрачные */
QFrame#taskCard QLabel,
QFrame#taskCard QWidget {

    background-color: transparent;

}



/* Заголовок задачи */
QLabel#taskTitleLabel {

    background-color: transparent;

    color: white;

    font-size: 16px;

    font-weight: 700;

}



/* Описание */
QLabel#taskDescriptionLabel {

    background-color: transparent;

    color: #c8d4e3;

    font-size: 14px;

}



/* Исполнитель */
QLabel#executorInfoLabel {

    background-color: transparent;

    color: #9fb0c5;

    font-size: 13px;

}



/* Дедлайн */
QLabel#deadlineInfoLabel {

    background-color: transparent;

    color: #9fb0c5;

    font-size: 13px;

}



/* Автор */
QLabel#authorInfoLabel {

    background-color: transparent;

    color: #71839a;

    font-size: 12px;

}



/* ===============================
   PRIORITY BADGES
   =============================== */


/* Низкий */
QLabel#priorityLow {

    background-color: #2ecc71;

    color: white;

    border-radius: 12px;

    padding: 4px 12px;

    font-size: 12px;

    font-weight: bold;

}



/* Средний */
QLabel#priorityMedium {

    background-color: #f39c12;

    color: white;

    border-radius: 12px;

    padding: 4px 12px;

    font-size: 12px;

    font-weight: bold;

}



/* Критичный */
QLabel#priorityCritical {

    background-color: #e74c3c;

    color: white;

    border-radius: 12px;

    padding: 4px 12px;

    font-size: 12px;

    font-weight: bold;

}



/* Блокер */
QLabel#priorityBlocker {

    background-color: #9b59b6;

    color: white;

    border-radius: 12px;

    padding: 4px 12px;

    font-size: 12px;

    font-weight: bold;

}