/* Заголовок */
QLabel#title {
    color: #f8fbff;
    font-size: 24px;
    font-weight: 700;
    padding: 12px;
    qproperty-alignment: AlignCenter;
}

/* Поле ввода */
QLineEdit {
    background: #222c3b;
    color: #ffffff;
    border: 2px solid #3a4558;
    border-radius: 14px;
    padding: 10px 14px;
    font-size: 14px;
    selection-background-color: #5b8cff;
}

QLineEdit:focus {
    border: 2px solid #5b8cff;
    background: #283345;
}

/* Кнопка */
QPushButton {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #6d7dff,
        stop:1 #4f7cff
    );
    color: white;
    border: none;
    border-radius: 14px;
    padding: 11px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #8294ff,
        stop:1 #5b8cff
    );
}

QPushButton:pressed {
    background: #4269d9;
}

QPushButton[text="Регистрация"] {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #3fd67b,
        stop:1 #26b862
    );
}

QPushButton[text="Регистрация"]:hover {
    background: #43dd83;
}

QPushButton#acceptInvitationButton {
    color: #dbe7f5;
    background: #243249;
    border: 1px solid #3b4b64;
}

QPushButton#acceptInvitationButton:hover {
    background: #30415d;
    border-color: #4b6385;
}

/* Сообщения об ошибках */
QLabel[objectName="error_label"] {
    color: #ff5d73;
    font-size: 13px;
    padding: 5px;
}

/* Обычный лейбл */
QLabel[objectName="label"] {
    color: #d6deeb;
    font-size: 14px;
    font-weight: 600;
    padding: 3px 0px;
}
