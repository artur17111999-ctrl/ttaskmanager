#menuPanel {
    background: #111827;
    border-right: 1px solid #26364d;
}

#menuHeader {
    color: #f8fafc;
    font-size: 25px;
    font-weight: 700;
    padding: 24px 22px 16px;
}

#menuButton {
    background: transparent;
    color: #aebed1;
    border: 1px solid transparent;
    border-radius: 10px;
    margin: 3px 10px;
    padding: 13px 16px;
    font-size: 16px;
    font-weight: 600;
    text-align: left;
}

#menuButton:hover { background: #1e293b; color: #f8fafc; }
#menuButton:checked { background: #2563eb; color: #ffffff; }

#userInfoLabel {
    color: #b7c5d8;
    border-top: 1px solid #26364d;
    margin: 12px 10px 4px;
    padding: 16px 8px 4px;
    font-size: 14px;
    font-weight: 600;
}

#contentArea { background: #0f172a; margin: 0; }

#emptyPage { color: #94a3b8; font-size: 22px; }

#headerPanel {
    background: #172033;
    border-bottom: 1px solid #26364d;
    min-height: 48px;
}

#pageTitleLabel { color: #f8fafc; font-size: 16px; font-weight: 650; }

#notificationButton {
    background: transparent;
    border: none;
    color: #cbd5e1;
    border-radius: 8px;
    font-size: 18px;
    padding: 6px;
}
#notificationButton:hover { background: #26364d; color: #ffffff; }

QMenu { background: #172033; border: 1px solid #334155; border-radius: 8px; padding: 5px; color: #f8fafc; }
QMenu::item { padding: 8px 22px; border-radius: 5px; }
QMenu::item:selected { background: #2563eb; }
