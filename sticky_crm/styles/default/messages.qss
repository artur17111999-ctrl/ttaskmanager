QFrame#bubbleFrame[isOwn="false"] { background-color: #1e293b; border-radius: 14px; }
QFrame#bubbleFrame[isOwn="true"] { background-color: #1d4ed8; border-radius: 14px; }
QFrame#messageBubble[selected="true"] { background-color: #172554; border: 1px solid #3b82f6; border-radius: 14px; }
QFrame#messageBubble[sourceTarget="true"] { background-color: #713f12; border: 2px solid #facc15; border-radius: 14px; }
QFrame#messageBubble[selected="true"] QFrame#bubbleFrame { background-color: #1e40af; }

QFrame#bubbleFrame QLabel { background: transparent; }
QLabel#messageText { color: #f8fafc; font-size: 10.5pt; }
QLabel#forwardedLabel { color: #a8bad0; font-size: 7pt; font-style: italic; }
QLabel#timeLabel { color: #a8bad0; font-size: 8pt; }
QFrame#bubbleFrame[isOwn="true"] QLabel#timeLabel { color: #dbeafe; }
QLabel#senderName { color: #93c5fd; font-weight: 700; font-size: 9pt; }
QLabel#statusIcon { color: #93c5fd; }
QLabel#messageText[deleted="true"] { color: #94a3b8; font-style: italic; }
QLabel#editedLabel { color: #b5cfdf; font-size: 8pt; }
QLabel#statusIcon[read="true"] { color: #7dd3fc; }
QLabel#dateSeparator {
    color: #8fa3b8;
    font-size: 8pt;
    padding: 6px 18px;
    margin: 8px 24px;
    border-top: 1px solid #334155;
    border-bottom: 1px solid #334155;
}

QLineEdit#editInput { background: #0f172a; border: 1px solid #3b82f6; border-radius: 10px; color: #f8fafc; padding: 8px; }
#inputFrame, #screenshotPreview { background: #172033; }
QLabel#screenshotAttachment { border: 1px solid #475569; border-radius: 8px; padding: 4px; }
