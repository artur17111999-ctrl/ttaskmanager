QWidget#employeesPage,
QWidget#employeesContent {
    background: #0f172a;
}

QFrame#employeesToolbar {
    background: #172033;
    border-bottom: 1px solid #2b3a50;
}

QLabel#employeesCompanyLabel {
    color: #f8fafc;
    font-size: 15px;
    font-weight: 600;
}

QLineEdit#employeesSearch {
    min-height: 34px;
    padding: 0 12px;
    color: #e8eef7;
    background: #111b27;
    border: 1px solid #34445c;
    border-radius: 7px;
}

QLineEdit#employeesSearch:focus {
    border-color: #3b82f6;
}

QToolButton#employeesRefreshButton {
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    background: #243249;
    border: 1px solid #34445c;
    border-radius: 7px;
}

QPushButton#employeesInviteButton {
    min-height: 34px;
    padding: 0 14px;
    color: #ffffff;
    background: #2563eb;
    border: 1px solid #3b82f6;
    border-radius: 7px;
    font-weight: 600;
}

QPushButton#employeesInviteButton:hover {
    background: #1d4ed8;
}

QToolButton#employeesActionsButton {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    color: #dbe7f5;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 20px;
}

QToolButton#employeesActionsButton:hover {
    background: #243249;
}

QToolButton#employeesActionsButton::menu-indicator {
    image: none;
    width: 0;
}

QToolButton#employeesRefreshButton:hover {
    background: #30415d;
    border-color: #4b6385;
}

QTableWidget#employeesTable {
    color: #e6edf6;
    background: #111b27;
    alternate-background-color: #162235;
    border: 1px solid #2f3e56;
    border-radius: 7px;
    selection-background-color: #234b83;
    selection-color: #ffffff;
    outline: none;
}

QTableWidget#employeesTable::item {
    padding: 7px 9px;
    border-bottom: 1px solid #243249;
}

QTableWidget#employeesTable::item:hover {
    background: #1e3048;
}

QTableWidget#employeesTable QHeaderView::section {
    min-height: 36px;
    padding: 0 9px;
    color: #b9c8da;
    background: #1b293d;
    border: none;
    border-right: 1px solid #2f3e56;
    border-bottom: 1px solid #34445c;
    font-weight: 600;
}

QLabel#employeesStateLabel {
    min-height: 80px;
    color: #94a3b8;
    font-size: 14px;
}

QDialog#employeeInvitationDialog {
    background: #0f172a;
}

QLabel#employeeDialogTitle {
    color: #f8fafc;
    font-size: 18px;
    font-weight: 700;
}

QLabel#employeeDialogNote {
    color: #94a3b8;
}

QDialog#employeeInvitationDialog QLineEdit,
QDialog#employeeInvitationDialog QComboBox,
QDialog#employeeInvitationDialog QDateEdit {
    min-height: 34px;
    padding: 0 10px;
    color: #e8eef7;
    background: #111b27;
    border: 1px solid #34445c;
    border-radius: 7px;
}

QDialog#employeeInvitationDialog QDialogButtonBox QPushButton {
    min-height: 34px;
    padding: 0 14px;
    color: #ffffff;
    background: #2563eb;
    border: 1px solid #3b82f6;
    border-radius: 7px;
    font-weight: 600;
}
