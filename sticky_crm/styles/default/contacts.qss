#contactsLeftPanel {
    background: #171d27;
    border-right: 1px solid #313a49;
}

#contactsTitle {
    color: white;
    font-size: 19px;
    font-weight: 700;
}

#contactsSearch {
    background: #222c3b;
    color: white;
    border: 2px solid #313a49;
    border-radius: 12px;
    padding: 8px;
}

#contactsSearch:focus {
    border: 2px solid #5b8cff;
}

#contactsList {
    background: #171d27;
    border: none;
    color: white;
}

#contactsList::item {
    border-radius: 10px;
    padding: 12px;
}

#contactsList::item:hover {
    background: #252f40;
}

#contactsList::item:selected {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #5b8cff,
        stop:1 #6f6dff
    );
}

#createGroupBtn {
    /* Стиль уже задан через auth.qss, но можем уточнить */
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #5b8cff,
        stop:1 #6f6dff
    );
    border-radius: 12px;
    margin-top: 8px;
}
#createGroupBtn:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #6c98ff,
        stop:1 #7ba5ff
    );
}
#contactsList::item {
    min-height: 38px;
    padding: 6px 10px;
    /* остальные стили */
}

/* Стили для панели заголовка чата */
#chatHeaderPanel {
    background: #171d27;
    border-bottom: 1px solid #313a49;
}

#chatHeader {
    color: white;
    font-size: 16px;
    font-weight: bold;
}

#deleteSelectedBtn {
    background-color: #e74c3c;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: bold;
}

#deleteSelectedBtn:hover {
    background-color: #c0392b;
}

#forwardSelectedBtn {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: bold;
}

#forwardSelectedBtn:hover {
    background-color: #2980b9;
}

#selectedCountLabel {
    color: #2ecc71;
    font-size: 12px;
    font-weight: bold;
}