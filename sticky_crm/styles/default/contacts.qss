#contactsLeftPanel {
    background: #17212b;
    border-right: 1px solid #263442;
}

#contactsTitle {
    color: #f5f8fc;
    font-size: 21px;
    font-weight: 700;
}

#contactsSearch {
    background: #263442;
    color: white;
    border: 1px solid transparent;
    border-radius: 18px;
    padding: 9px 12px;
}

#contactsSearch:focus {
    border: 1px solid #3390ec;
}

#contactsList {
    background: #171d27;
    border: none;
    color: white;
}

#contactsList::item {
    border-radius: 12px;
    padding: 10px 12px;
    margin: 1px 0;
}

#contactsList::item:hover {
    background: #252f40;
}

#contactsList::item:selected {
    background: #2b5278;
}

#createGroupBtn {
    /* Стиль уже задан через auth.qss, но можем уточнить */
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #5b8cff,
        stop:1 #6f6dff
    );
    border-radius: 18px;
    color: white;
    font-size: 20px;
    font-weight: bold;
}
#createGroupBtn:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #6c98ff,
        stop:1 #7ba5ff
    );
}
#contactsList::item {
    min-height: 38px;
    padding: 6px 10px;
    /* остальные стили */
}

/* Стили для панели заголовка чата */
#chatHeaderPanel {
    background: #171d27;
    border-bottom: 1px solid #313a49;
}

#chatHeader {
    color: white;
    font-size: 16px;
    font-weight: bold;
}

#deleteSelectedBtn {
    background-color: #e74c3c;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: bold;
}

#deleteSelectedBtn:hover {
    background-color: #c0392b;
}

#forwardSelectedBtn {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: bold;
}

#forwardSelectedBtn:hover {
    background-color: #2980b9;
}

#selectedCountLabel {
    color: #2ecc71;
    font-size: 12px;
    font-weight: bold;
}

/* Message search field */
#messageSearch {
    min-height: 34px;
    max-width: 300px;
    padding: 0 12px;
    border: 1px solid #d8e2ef;
    border-radius: 17px;
    background: #f4f7fb;
    color: #203040;
}
#messageSearch:focus { border: 1px solid #3390ec; background: #ffffff; }
