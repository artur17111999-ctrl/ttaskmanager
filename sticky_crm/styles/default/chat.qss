#chatHeader {
    border-bottom: 1px solid #24313d;
    color: white;
    font-size: 16px;
    font-weight: 600;
    padding: 0;
}

#chatHeaderPanel {
    background: #17212b;
    border-bottom: 1px solid #24313d;
}

/* Кнопки действий для выделенных сообщений */
QPushButton#deleteSelectedBtn,
QPushButton#forwardSelectedBtn {
    background: #3390ec;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 10pt;
    font-weight: 500;
    min-width: 120px;
}

QPushButton#deleteSelectedBtn:hover,
QPushButton#forwardSelectedBtn:hover {
    background: #4aa3ff;
}

QPushButton#deleteSelectedBtn:pressed,
QPushButton#forwardSelectedBtn:pressed {
    background: #2a7bc4;
}

/* Метка количества выделенных сообщений */
QLabel#selectedCountLabel {
    color: #8fa3b8;
    font-size: 10pt;
    padding: 8px;
    font-weight: bold;
}

/* Сама QScrollArea – прозрачная */
QScrollArea#messageArea {
    background: #0e1621;
    border: none;
}

/* Внутренний контейнер, где лежат сообщения */
#scrollContainer {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #0e1621,
        stop:1 #17212b
    );
}

#messageInput {
    background: #263442;
    color: white;
    border: 1px solid #263442;
    border-radius: 20px;
    padding: 10px 14px;
    font-size: 10.5pt;
}

#messageInput:focus {
    border: 1px solid #3390ec;
}

#sendBtn {
    background: #3390ec;
    color: white;
    border: none;
    border-radius: 22px;
    min-width: 42px;
    min-height: 42px;
}

#sendBtn:hover {
    background: #4aa3ff;
}
