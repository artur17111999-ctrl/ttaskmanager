QFrame#stickyNote {
    background: #fff59a;
    color: #111111;
    border: 2px solid #c9a800;
    border-radius: 6px;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}
QFrame#stickyNote[stickyColorKey="red"] { background: #ffb3b3; color: #111111; border-color: #e05555; }
QFrame#stickyNote[stickyColorKey="yellow"] { background: #fff59a; color: #111111; border-color: #c9a800; }
QFrame#stickyNote[stickyColorKey="green"] { background: #b6f5c8; color: #111111; border-color: #3aad60; }
QFrame#stickyNote[stickyColorKey="grey"] { background: #e4e6ea; color: #111111; border-color: #8a909e; }

QFrame#stickyNote QLineEdit#stickyTitle {
    background: rgba(0, 0, 0, 0.12);
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: 500;
    min-width: 112px;
    max-width: 150px;
    color: #111111;
    selection-color: #111111;
}
QFrame#stickyNote QComboBox, QFrame#stickyNote QPushButton {
    background: rgba(0, 0, 0, 0.14);
    border: 1px solid rgba(80, 40, 0, 0.18);
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 24px;
}
QFrame#stickyNote QComboBox#stickyMode { max-width: 150px; }
QFrame#stickyNote QPushButton:hover, QFrame#stickyNote QComboBox:hover { background: rgba(0, 0, 0, 0.22); }
QFrame#stickyNote QTextEdit#stickyText {
    background: transparent;
    border: none;
    padding: 8px 10px;
    selection-background-color: rgba(80, 40, 0, 0.22);
    color: #111111;
    selection-color: #111111;
}
QFrame#stickyNote QLabel#stickySource {
    padding: 4px 10px;
    border-bottom: 1px solid rgba(80, 40, 0, 0.18);
    color: rgba(20, 20, 20, 0.68);
    font-size: 11px;
}
QFrame#stickyNote QPushButton#stickySave, QFrame#stickyNote QPushButton#stickyClose {
    min-width: 32px; max-width: 32px;
    min-height: 30px; max-height: 30px;
    padding: 0;
}
QFrame#stickyNote QPushButton#stickyMinimize {
    min-width: 32px; max-width: 32px;
    min-height: 30px; max-height: 30px;
    padding: 0;
    font-size: 22px;
    font-weight: 500;
}
QFrame#stickyNote QPushButton#stickySave,
QFrame#stickyNote QPushButton#stickyMinimize,
QFrame#stickyNote QPushButton#stickyClose { margin-left: 0; }
QFrame#stickyNote QPushButton#stickyLevel { min-width: 52px; max-width: 52px; min-height: 28px; max-height: 28px; font-size: 13px; }
QFrame#stickyNote QPushButton#stickyLevel { color: #111111; }
QFrame#stickyHeader { background: rgba(0,0,0,0.10); border-bottom: 1px solid rgba(0,0,0,0.15); border-radius: 4px 4px 0 0; }
QFrame#stickyFooter { background: rgba(0,0,0,0.08); border-top: 1px solid rgba(0,0,0,0.12); border-radius: 0 0 4px 4px; }
QFrame#stickyNote QPushButton#stickyClose { background: #ff6b6b; color: white; }
QFrame#stickyNote QPushButton#stickyClose:hover { background: #e05555; }
QFrame#stickyNote QPushButton#stickyMinimize, QFrame#stickyNote QPushButton#stickySave { background: rgba(0,0,0,0.18); }
QFrame#stickyNote QPushButton[colorKey="red"] { background: #fca5a5; border: 2px solid #e05555; border-radius: 11px; padding: 0; }
QFrame#stickyNote QPushButton[colorKey="yellow"] { background: #fef3a5; border: 2px solid #c9a800; border-radius: 11px; padding: 0; }
QFrame#stickyNote QPushButton[colorKey="green"] { background: #bbf7d0; border: 2px solid #3aad60; border-radius: 11px; padding: 0; }
QFrame#stickyNote QPushButton[colorKey="grey"] { background: #d1d5db; border: 2px solid #8a909e; border-radius: 11px; padding: 0; }
QFrame#stickyNote QPushButton[colorKey="red"][active="true"], QFrame#stickyNote QPushButton[colorKey="yellow"][active="true"], QFrame#stickyNote QPushButton[colorKey="green"][active="true"], QFrame#stickyNote QPushButton[colorKey="grey"][active="true"] { border-width: 3px; }
